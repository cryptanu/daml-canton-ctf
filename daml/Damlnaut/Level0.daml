module Damlnaut.Level0 where

import Damlnaut.FlagIssuer

-- Level 0 proves the player can create a local instance and submit it.
template Level0Instance
  with
    player : Party
    issuer : Party
    instanceId : Text
    instructions : Text
  where
    signatory player
    observer issuer

    choice SubmitLevel0 : ContractId FlagProof
      controller player
      do
        create FlagProof with
          solver = player
          issuer = issuer
          level = "level-0"
          instanceId = instanceId
          proof = "level-0-submitted"
