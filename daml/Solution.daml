module Solution where

import Daml.Script
import Damlnaut.Level0

solveLevel0 : Script (ContractId FlagProof)
solveLevel0 = script do
  player <- allocateParty "level0-player"

  instanceCid <- submit player do
    createCmd Level0Instance with
      player = player
      instructions = "Exercise SubmitLevel0 to create the Level 0 proof."

  proofCid <- submit player do
    exerciseCmd instanceCid SubmitLevel0

  Some proof <- queryContractId player proofCid
  assertMsg "PROOF_LEVEL_MISMATCH" (proof.level == "level-0")
  assertMsg "PROOF_INSTANCE_MISMATCH" (proof.instanceCid == instanceCid)
  assertMsg "PROOF_VALUE_MISMATCH" (proof.proof == "level-0-submitted")

  pure proofCid
