# The public URL of the Canton JSON Ledger API the backend talks to.
# Local dev with `canton sandbox --json-api-port 7575` :
#   DAML_JSON_API_URL=http://localhost:7575
# Vercel with a tunnel from your Mac (ngrok, cloudflared, tailscale funnel):
#   DAML_JSON_API_URL=https://<random-subdomain>.ngrok-free.app
DAML_JSON_API_URL=http://localhost:7575

# Local dev only. Vercel picks its own port.
PORT=8787
