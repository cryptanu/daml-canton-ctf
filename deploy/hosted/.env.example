# Copy to .env. Never commit it.
CANTON_JAR=/absolute/path/to/sdk/3.4.10/canton/canton.jar
POSTGRES_PASSWORD=replace-with-a-random-password
ADMIN_TOKEN=replace-with-a-random-token
GATEWAY_CLIENT_SECRET=replace-with-a-random-secret
# Public hostnames. Use real DNS names in production (Caddy gets TLS certs automatically).
API_SITE=http://api.localhost
WALLET_SITE=http://wallet.localhost
HTTP_PORT=80
HTTPS_PORT=443
# Origins allowed to call the gateway (your frontend). "*" for local only.
GATEWAY_ALLOWED_ORIGINS=*
