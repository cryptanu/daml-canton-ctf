# Build context: repo root. Run `./damlw build` first so .daml/dist/*.dar exists.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY server ./server
COPY shared ./shared
COPY scripts/demo-solve.mts ./scripts/demo-solve.mts
COPY .daml/dist/*.dar ./packages/
ENV PORT=8787 DAR_DIRS=packages
EXPOSE 8787
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=4 \
  CMD wget -qO- http://127.0.0.1:8787/api/health | grep -q '"reachable":true' || exit 1
CMD ["npx", "tsx", "server/index.ts"]
