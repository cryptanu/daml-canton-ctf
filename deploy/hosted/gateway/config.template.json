{
  "kernel": { "id": "remote-da", "clientType": "remote" },
  "logging": { "level": "info", "format": "json" },
  "server": {
    "port": ${GATEWAY_PORT},
    "dappPath": "/api/v0/dapp",
    "userPath": "/api/v0/user",
    "allowedOrigins": "${GATEWAY_ALLOWED_ORIGINS}",
    "requestSizeLimit": "5mb",
    "requestRateLimit": 1000,
    "trustProxy": true,
    "admin": "sub",
    "signingWorker": { "pollInterval": 5000 }
  },
  "signingStore": { "connection": { "type": "sqlite", "database": "data/signing_store.sqlite" } },
  "store": { "connection": { "type": "sqlite", "database": "data/store.sqlite" } },
  "bootstrap": {
    "idps": [{ "id": "idp-self-signed", "type": "self_signed", "issuer": "unsafe-auth" }],
    "networks": [
      {
        "id": "canton:damlnaut-sandbox",
        "name": "Damlnaut sandbox",
        "description": "Damlnaut CTF participant",
        "identityProviderId": "idp-self-signed",
        "auth": {
          "method": "self_signed", "issuer": "self-signed", "audience": "damlnaut",
          "scope": "openid email daml_ledger_api offline_access",
          "clientId": "${GATEWAY_LEDGER_USER}", "clientSecret": "${GATEWAY_CLIENT_SECRET}"
        },
        "adminAuth": {
          "method": "self_signed", "issuer": "self-signed", "scope": "daml_ledger_api",
          "audience": "damlnaut", "clientId": "${GATEWAY_LEDGER_USER}-admin", "clientSecret": "${GATEWAY_CLIENT_SECRET}"
        },
        "ledgerApi": { "baseUrl": "${LEDGER_API_URL}" }
      }
    ]
  },
  "hashingScheme": { "version": "HASHING_SCHEME_VERSION_V2" }
}
