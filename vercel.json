{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "{server,shared}/**"
    }
  }
}
